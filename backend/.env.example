# --- General ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Sign-in mode ---
# dev     = SIMULATED sign-in (x-dev-user header). Development only. Refused in production.
# session = real accounts with passwords, MFA and server-side sessions.
AUTH_MODE=dev

# --- Database ---
# Leave DATABASE_URL unset in development to run with demo data in memory (NOTHING IS SAVED).
# Without installing PostgreSQL you can run an embedded real engine:  npm run db:embedded
# DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
# Development conveniences (ignored in production):
# AUTO_MIGRATE=true
# SEED_DEMO=true

# --- Session mode (required when AUTH_MODE=session) ---
# 64 hex characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_ENCRYPTION_KEY=
# COOKIE_SECURE=true
# TRUST_PROXY=1
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_RATE_LIMIT_MAX=20
# Copy this file to .env and fill it in. .env is NOT committed to git.
# Values already set in your shell or on the host (Render) take priority over this file.

# ---------------- General ----------------
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API. Must be https:// in production.
CORS_ORIGINS=http://localhost:5173

# ---------------- Sign-in mode ----------------
# dev     = SIMULATED sign-in (pick any seeded user). Development only; refused in production.
# session = real accounts with passwords, authenticator-app MFA and server-side sessions.
AUTH_MODE=dev

# ---------------- Database ----------------
# Empty = demo data in memory (NOTHING IS SAVED). To use PostgreSQL, set it, e.g. the embedded dev engine:
#   DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres     (run: npm run db:embedded)
DATABASE_URL=
# true to require a verified TLS connection (use with an external database URL)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Development conveniences (ignored in production)
AUTO_MIGRATE=false
SEED_DEMO=false
# Embedded development database (npm run db:embedded)
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_DIR=./.pgdata

# ---------------- Session mode (required when AUTH_MODE=session) ----------------
# 64 hex characters (32 bytes). Encrypts authenticator secrets. Generated for you; keep it secret and backed up.
AUTH_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Number of proxies in front of the app (0 locally; 2 on Render behind the Vercel proxy)
TRUST_PROXY=0
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Sign-in attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=20

# ---------------- First-start provisioning (hosts without a shell) ----------------
# Set PROVISION_ON_START=true for ONE start, then remove the password. Only acts on an empty system.
PROVISION_ON_START=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Accountant-approved reference data as ONE line of JSON (format: docs/pilot-config.example.json)
PILOT_CONFIG_JSON=

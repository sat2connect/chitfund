{
    "name":  "chitfund-crm-backend",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "migrate":  "tsx src/cli/migrate.ts",
                    "bootstrap-admin":  "tsx src/cli/bootstrapAdmin.ts",
                    "init-pilot":  "tsx src/cli/initPilot.ts",
                    "db:embedded":  "tsx src/cli/embeddedDb.ts",
                    "migrate:prod":  "node dist/cli/migrate.js",
                    "bootstrap-admin:prod":  "node dist/cli/bootstrapAdmin.js",
                    "init-pilot:prod":  "node dist/cli/initPilot.js"
                },
    "dependencies":  {
                         "cors":  "^2.8.6",
                         "express":  "^5.3.0",
                         "pg":  "^8.23.1"
                     },
    "devDependencies":  {
                            "@electric-sql/pglite":  "^0.5.9",
                            "@electric-sql/pglite-socket":  "^0.2.12",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^26.6.5",
                            "@types/pg":  "^8.23.1",
                            "@types/supertest":  "^7.2.1",
                            "supertest":  "^7.3.1",
                            "tsx":  "^4.23.15",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.4"
                        }
}
# Copy this file to .env. .env is NOT committed to git.
# Anything starting with VITE_ is bundled into the page and is PUBLIC: never put a secret here.

# Base URL of the backend API.
#  - local development: the backend directly
#  - Vercel (production): use the relative value /api/v1 so calls go through the same-origin proxy in vercel.json
VITE_API_BASE_URL=http://localhost:4000/api/v1

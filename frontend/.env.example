# Copy this file to .env. .env is NOT committed to git.
# Anything starting with VITE_ is bundled into the page and is PUBLIC: never put a secret here.

# Base URL of the backend API for LOCAL DEVELOPMENT.
# Production builds ignore this and always use the same-origin /api/v1 (Vercel proxies it to the backend),
# so you do NOT need to set it on Vercel.
VITE_API_BASE_URL=http://localhost:4000/api/v1
